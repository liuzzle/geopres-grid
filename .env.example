# Required. Absolute path to the repo root.
PROJECT_ROOT=/absolute/path/to/geopres-grid

# All large artefacts live here. Point this at a big disk, not at the repo.
# Defaults to $PROJECT_ROOT/storage if unset.
STORAGE_PATH=/absolute/path/to/storage

# Derived paths. Each defaults to a subdirectory of $STORAGE_PATH.
# EMBEDDING_CACHE_PATH=/absolute/path/to/storage/cache
# EVALUATION_RESULTS_PATH=/absolute/path/to/storage/evaluation_results
# TRAINED_MODELS_PATH=/absolute/path/to/storage/trained_models

# Optional. Only needed for gated datasets; none of the five backbones is gated.
# HF_TOKEN=
